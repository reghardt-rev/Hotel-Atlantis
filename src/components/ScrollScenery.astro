---
/**
 * Decorative scroll scenery for the homepage.
 *
 * A wave washes over the whole page as you scroll away from the hero: it sweeps
 * up the screen, passes off the top, and leaves the page clear behind it. It is
 * driven by scroll position rather than played as a one-shot animation, so
 * scrolling back up runs it in reverse and it always matches where you are.
 *
 * A sun sits in the right-hand gutter, high on arrival and setting as you travel
 * down the page.
 *
 * Purely ornamental — aria-hidden and pointer-events:none, so it is invisible to
 * assistive tech and can never swallow a click.
 */
---

<div class="wash" data-wash aria-hidden="true">
  <div class="wash__body" data-wash-body>
    <div class="wash__crest"></div>
    <div class="wash__water"></div>
  </div>
</div>

<div class="scenery" data-scenery aria-hidden="true">
  <div class="scenery-sun" data-sun>
    <span class="scenery-sun__glow"></span>
    <span class="scenery-sun__warm"></span>
    <span class="scenery-sun__pale"></span>
  </div>
</div>

<script>
  const wash = document.querySelector<HTMLElement>('[data-wash]');
  const scenery = document.querySelector<HTMLElement>('[data-scenery]');

  if (wash || scenery) {
    const sun = scenery?.querySelector<HTMLElement>('[data-sun]');
    const hero = document.querySelector<HTMLElement>('[data-carousel]');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (still) {
      // A full-page wash is exactly the kind of motion this setting asks us to
      // drop, so it stays off; the sun is shown but never moves.
      sun?.style.setProperty('--sun-t', '0.8');
      scenery?.toggleAttribute('data-visible', true);
    } else {
      let queued = false;
      const clamp = (n: number) => (n < 0 ? 0 : n > 1 ? 1 : n);

      function frame() {
        queued = false;
        const y = window.scrollY;
        const heroHeight = hero?.offsetHeight ?? window.innerHeight;

        // The wave crosses the screen over roughly one viewport of scrolling,
        // starting while the hero is still on its way out.
        const washFrom = heroHeight * 0.55;
        const washTo = heroHeight * 1.4;
        const p = clamp((y - washFrom) / (washTo - washFrom));
        if (wash) {
          wash.style.setProperty('--wash-p', p.toFixed(4));
          // Off-screen at either end — no reason to keep compositing it.
          wash.toggleAttribute('data-active', p > 0 && p < 1);
        }

        // The sun tracks scroll position: high where the scenery begins, fully
        // set at the foot of the page. Scrolling back up raises it again.
        const from = heroHeight * 0.65;
        const to = Math.max(from + 1, document.documentElement.scrollHeight - window.innerHeight);
        sun?.style.setProperty('--sun-t', (1 - clamp((y - from) / (to - from))).toFixed(4));
        scenery?.toggleAttribute('data-visible', y > from);
      }

      window.addEventListener(
        'scroll',
        () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(frame);
          }
        },
        { passive: true },
      );

      window.addEventListener('resize', frame, { passive: true });
      frame();
    }
  }
</script>
