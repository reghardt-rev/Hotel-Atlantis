---
/**
 * Hero direct-booking badge — what the guest gets by booking on this site, and
 * the way to act on it.
 *
 * Sits under the review panel and shares its panel treatment so the two read as
 * one stack of overlays on the photograph rather than unrelated boxes. The
 * pairing is the argument: the reviews are the OTA's social proof, and this is
 * the reason not to go back there to act on it. Of the two it is the one making
 * a case, so it carries the halo.
 *
 * The panel itself is the button. It carries `.distributor`, so Mews opens the
 * booking engine from it directly, and `data-book-location`, so it reports to
 * GA4 exactly as any Book now button does. There is no separate button inside
 * it: the box is one argument, and asking a reader already convinced by it to
 * find a small target at the bottom only adds a step.
 *
 * A div is not a button, so it is given the part of one that matters: a role, a
 * place in the tab order, a label, a focus ring, and a key handler, because
 * Enter on a focusable div fires no click of its own. Without those the panel
 * would be reachable by mouse alone.
 *
 * The Mews loader and the click tracker both live in BookNow.astro and bind to
 * every `.distributor` on the page, this panel included. The header and the side
 * menu each render one, so that script is always present wherever this box is.
 *
 * It reports itself to GA4 as `direct_booking_box` rather than sharing a name
 * with the header or the booking bar, so the panel can be judged on its own: it
 * is the one thing on the hero making a case for booking here, and whether that
 * case works is a question its own figure has to answer. Same name as the
 * equivalent box on Hotel Paradis, so the two properties stay comparable in GA4.
 *
 * Copy is edited per language at /keystatic under "Book direct".
 */
import type { DirectBookingBenefit } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  items: DirectBookingBenefit[];
  /** Mews Distributor configuration id, from Site settings. */
  configId?: string;
  class?: string;
}
const { locale, title, items, configId, class: className = '' } = Astro.props;
const tr = t(locale);
---

{/* `pointer-events-auto`: the band this sits in is passed through so the
    change-slide halves underneath keep their clicks, and anything in here that
    wants its own has to say so. The review panel above does the same. */}
<div
  data-direct-booking
  data-mews-config={configId}
  data-book-location="direct_booking_box"
  role="button"
  tabindex="0"
  aria-label={`${title}. ${tr.book}`}
  class:list={[
    'distributor hero-panel hero-panel--glow hero-panel--jiggle pointer-events-auto w-fit max-w-[18rem] cursor-pointer px-5 py-4 text-ink',
    'focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2',
    className,
  ]}
>
  {/* Deliberately larger and heavier than the scores above it: this is the one
      thing on the hero making an argument, so it leads the pair. */}
  <p class="text-[1.05rem] font-bold uppercase leading-none tracking-[0.12em]">{title}</p>
  <ul class="mt-3.5 space-y-2">
    {items.map((item) => (
      <li class="flex items-start gap-2 text-[0.8rem] leading-snug text-ink">
        {/* The tick takes the accent, not ink: it is the only repeated mark in
            the box, and in the site's blue it reads as a list of things you get
            rather than as punctuation. */}
        <svg
          class="mt-px h-3.5 w-3.5 shrink-0 text-clay"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <span>{item.text}</span>
      </li>
    ))}
  </ul>

</div>

<script>
  // Enter and Space on a focusable div do nothing on their own, so they are
  // turned into the click that Mews and the tracker are both already listening
  // for. Space is also the page-down key, and would scroll the hero out from
  // under the reader on its way to opening the engine.
  document.querySelectorAll<HTMLElement>('[data-direct-booking]').forEach((panel) => {
    panel.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ' && e.key !== 'Spacebar') return;
      e.preventDefault();
      panel.click();
    });
  });
</script>
