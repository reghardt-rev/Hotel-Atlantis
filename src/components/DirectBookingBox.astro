---
/**
 * Hero direct-booking badge — what the guest gets by booking on this site.
 *
 * Sits top left, opposite the review score, and shares its panel treatment so
 * the two read as a matched pair framing the photograph rather than as unrelated
 * boxes. The pairing is the argument: the score is the OTA's social proof, and
 * this is the reason not to go back there to act on it. Of the two it is the one
 * making a case, so it takes the halo and the left corner, where a reader's eye
 * lands first.
 *
 * Its left edge is the booking bar's, not the rating's: see the note in
 * Carousel.astro on why the two panels are hung on different measures.
 *
 * Copy is edited per language at /keystatic under "Book direct".
 */
import type { DirectBookingBenefit } from '../lib/content';

interface Props {
  title: string;
  items: DirectBookingBenefit[];
  class?: string;
}
const { title, items, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'hero-panel hero-panel--glow hero-panel--jiggle w-fit max-w-[18rem] px-5 py-4 text-white',
    className,
  ]}
>
  {/* Deliberately larger and heavier than the score above it: this is the one
      thing on the hero making an argument, so it leads the pair. */}
  <p class="text-[1.05rem] font-bold uppercase leading-none tracking-[0.12em]">{title}</p>
  <ul class="mt-3.5 space-y-2">
    {items.map((item) => (
      <li class="flex items-start gap-2 text-[0.8rem] leading-snug text-white">
        <svg
          class="mt-px h-3.5 w-3.5 shrink-0 text-white drop-shadow-sm"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <span>{item.text}</span>
      </li>
    ))}
  </ul>
</div>
