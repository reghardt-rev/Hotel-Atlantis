---
/**
 * Hero direct-booking badge — what the guest gets by booking on this site, and
 * the way to act on it.
 *
 * Sits under the review panel and shares its panel treatment so the two read as
 * one stack of overlays on the photograph rather than unrelated boxes. The
 * pairing is the argument: the reviews are the OTA's social proof, and this is
 * the reason not to go back there to act on it. Of the two it is the one making
 * a case, so it carries the halo.
 *
 * The whole panel opens the booking engine, not just the button inside it: the
 * box is one argument, and a reader who is convinced by it should not have to
 * find the small target at the bottom. The button is still there and still real,
 * because a panel that is only clickable by script is unreachable from a
 * keyboard; the panel simply forwards its clicks to it.
 *
 * It reports itself to GA4 as `direct_booking_box` rather than sharing a name
 * with the header or the booking bar, so the panel can be judged on its own: it
 * is the one thing on the hero making a case for booking here, and whether that
 * case works is a question its own figure has to answer. Same name as the
 * equivalent box on Hotel Paradis, so the two properties stay comparable in GA4.
 *
 * Copy is edited per language at /keystatic under "Book direct".
 */
import BookNow from './BookNow.astro';
import type { DirectBookingBenefit } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  items: DirectBookingBenefit[];
  /** Mews Distributor configuration id, from Site settings. */
  configId?: string;
  class?: string;
}
const { locale, title, items, configId, class: className = '' } = Astro.props;
const tr = t(locale);
---

{/* `pointer-events-auto`: the band this sits in is passed through so the
    change-slide halves underneath keep their clicks, and anything in here that
    wants its own has to say so. The review panel above does the same. */}
<div
  data-direct-booking
  class:list={[
    'hero-panel hero-panel--glow hero-panel--jiggle pointer-events-auto w-fit max-w-[18rem] cursor-pointer px-5 py-4 text-ink',
    className,
  ]}
>
  {/* Deliberately larger and heavier than the scores above it: this is the one
      thing on the hero making an argument, so it leads the pair. */}
  <p class="text-[1.05rem] font-bold uppercase leading-none tracking-[0.12em]">{title}</p>
  <ul class="mt-3.5 space-y-2">
    {items.map((item) => (
      <li class="flex items-start gap-2 text-[0.8rem] leading-snug text-ink">
        {/* The tick takes the accent, not ink: it is the only repeated mark in
            the box, and in the site's blue it reads as a list of things you get
            rather than as punctuation. */}
        <svg
          class="mt-px h-3.5 w-3.5 shrink-0 text-clay"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <span>{item.text}</span>
      </li>
    ))}
  </ul>

  <BookNow
    configId={configId}
    label={tr.book}
    location="direct_booking_box"
    class="mt-4 w-full justify-center !px-5 !py-2 text-[0.8rem]"
  />
</div>

<script>
  // The panel forwards its clicks to the button inside it, rather than carrying
  // `.distributor` itself. Two triggers on one box would open the engine twice
  // and report two clicks for one intent, and the button is the one that a
  // keyboard can reach, so it is the one that counts.
  document.querySelectorAll<HTMLElement>('[data-direct-booking]').forEach((panel) => {
    const button = panel.querySelector<HTMLElement>('.distributor');
    if (!button) return;

    panel.addEventListener('click', (e) => {
      // A click that already landed on the button is on its way to Mews and to
      // the tracker; forwarding it would double both.
      if ((e.target as HTMLElement).closest('.distributor')) return;
      button.click();
    });
  });
</script>
