---
/**
 * Direct-booking promo. Opens ten seconds after the visitor lands, lists the
 * current offers, and can be dismissed.
 *
 * It is marked as seen when it *opens*, not when it closes, so a visitor who
 * navigates away rather than closing it does not get it again on the next page.
 * sessionStorage rather than localStorage: it returns on a later visit, but
 * never twice in one browse.
 */
import BookNow from './BookNow.astro';
import { listOffers } from '../lib/content';
import { t, localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  mewsConfigId?: string;
  /** Milliseconds after load before it opens. */
  delay?: number;
}
const { locale, mewsConfigId, delay = 10000 } = Astro.props;
const tr = t(locale);
const offers = await listOffers(locale);
---

<div data-promo data-delay={delay} class="intro-hide" hidden>
  <div data-promo-backdrop class="fixed inset-0 z-[60] bg-ink/60 backdrop-blur-sm"></div>

  <div
    class="fixed inset-0 z-[70] flex items-center justify-center overflow-y-auto p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="promo-title"
  >
    <div class="promo-card relative my-auto w-full max-w-lg rounded-2xl bg-paper shadow-2xl">
      <button
        type="button"
        data-promo-close
        aria-label={tr.promo.close}
        class="absolute right-3 top-3 flex h-9 w-9 cursor-pointer items-center justify-center rounded-full text-xl leading-none text-muted transition-colors hover:bg-sand hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-clay"
      >×</button>

      <div class="px-6 py-8 sm:px-8">
        <p class="text-xs uppercase tracking-[0.3em] text-clay">{tr.nav.offers}</p>
        <h2 id="promo-title" class="mt-3 font-serif text-3xl leading-tight sm:text-4xl">{tr.promo.title}</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">{tr.promo.body}</p>

        {offers.length > 0 && (
          <ul class="mt-6 divide-y divide-stone-warm border-y border-stone-warm">
            {offers.map((offer) => (
              <li class="py-4">
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="font-serif text-xl">{offer.entry.title}</h3>
                  {offer.entry.priceFrom != null && (
                    <span class="shrink-0 text-sm text-muted">{tr.from} €{offer.entry.priceFrom}</span>
                  )}
                </div>
                {offer.entry.summary && (
                  <p class="mt-1 text-sm leading-relaxed text-muted">{offer.entry.summary}</p>
                )}
              </li>
            ))}
          </ul>
        )}

        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
          <BookNow configId={mewsConfigId} label={tr.book} location="promo_popup" />
          <a href={localePath(locale, '/offers')} class="text-sm font-medium text-clay hover:underline">
            {tr.promo.allOffers} →
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const promo = document.querySelector<HTMLElement>('[data-promo]');

  if (promo) {
    const KEY = 'atlantis-promo-seen';
    const delay = Number(promo.dataset.delay) || 10000;
    const closeBtn = promo.querySelector<HTMLButtonElement>('[data-promo-close]');
    let restoreFocus: HTMLElement | null = null;

    // Storage can throw in private modes; a failure there must not break the page.
    const seen = () => {
      try {
        return sessionStorage.getItem(KEY) === '1';
      } catch {
        return false;
      }
    };
    const markSeen = () => {
      try {
        sessionStorage.setItem(KEY, '1');
      } catch {
        /* ignore */
      }
    };

    function open() {
      if (!promo.hidden) return;
      markSeen();
      restoreFocus = document.activeElement as HTMLElement;
      promo.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function close() {
      if (promo.hidden) return;
      promo.hidden = true;
      document.body.style.overflow = '';
      restoreFocus?.focus?.();
    }

    // Never cover the cookie banner: if the visitor has not chosen yet, wait for
    // them to, then show the promo.
    const consentPending = () => {
      try {
        return localStorage.getItem('atlantis-consent') === null;
      } catch {
        return false;
      }
    };

    if (!seen()) {
      setTimeout(() => {
        if (consentPending()) {
          window.addEventListener('atlantis:consent', () => setTimeout(open, 600), { once: true });
        } else {
          open();
        }
      }, delay);
    }

    closeBtn?.addEventListener('click', close);
    promo.querySelector('[data-promo-backdrop]')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    // Booking from inside the modal should hand over to Mews, not sit behind it.
    promo.querySelector('.distributor')?.addEventListener('click', () => setTimeout(close, 50));
  }
</script>
