---
/**
 * Guest reviews as one continuously moving line.
 *
 * The phone counterpart to the panel on the hero. That panel is a stack in a
 * corner, which a phone has no corner to spare for, so the same quotes run
 * along a single line here instead and take one line of height rather than a
 * quarter of the screen.
 *
 * The two never appear together: this is `lg:hidden` and the panel is
 * `hidden lg:block`, so exactly one of them is displayed at any width. That
 * matters for more than tidiness. `display: none` takes an element out of the
 * accessibility tree, so a screen reader is read the quotes once whichever way
 * the page is being viewed, never twice.
 *
 * The loop is the oldest trick there is: the list is rendered twice and the
 * track is slid exactly half its own width, at which point the second copy is
 * sitting where the first began and the animation restarts on an identical
 * frame. The duplicate is `aria-hidden`, being the same sentences again.
 */
import { t, localeTags, type Locale } from '../lib/i18n';
import type { Review } from '../lib/content';

interface Props {
  locale: Locale;
  reviews: Review[];
  /** Credited once at the head of the line, e.g. Booking.com. */
  source?: string | null;
  class?: string;
}
const { locale, reviews, source, class: className = '' } = Astro.props;
const tr = t(locale);

const tag = localeTags[locale];
const fmtOne = new Intl.NumberFormat(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const fmtWhole = new Intl.NumberFormat(tag, { maximumFractionDigits: 0 });
// One decimal, as every OTA writes them, except a perfect score: Booking.com
// says 10, not 10.0, and so should this.
const fmtScore = (n: number) => (n >= 10 ? fmtWhole.format(n) : fmtOne.format(n));

// Constant speed whatever the list length. The track slides its own width, and
// that width is proportional to the characters in it, so the duration has to be
// too: a fixed duration would crawl through three reviews and race through ten.
// Roughly sixty pixels a second at this size, floored so a short list still
// reads as a drift rather than a dash.
const characters = reviews.reduce((n, r) => n + r.text.length + 8, 0);
const seconds = Math.max(45, Math.round(characters / 13));

// Sentence case: this is read out as the name of a region, not as body copy,
// and `reviewsLabel` is a mid-sentence word everywhere else it is used.
const label = (() => {
  const text = [tr.reviewsLabel, source ? `${tr.reviewsOn} ${source}` : '']
    .filter(Boolean)
    .join(' ');
  return text.charAt(0).toUpperCase() + text.slice(1);
})();
---

{reviews.length > 0 && (
  <section
    class:list={['review-ticker border-b border-stone-warm bg-sand py-3', className]}
    style={`--ticker-seconds:${seconds}s`}
    aria-label={label}
  >
    <div class="review-ticker__track">
      {[0, 1].map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {reviews.map((review) => (
            <li class="flex shrink-0 items-center gap-2 whitespace-nowrap px-5 text-[0.8rem]">
              <span class="font-medium text-clay">
                {fmtScore(review.score)}<span class="text-muted">/10</span>
              </span>
              <span class="text-muted">{`“${review.text}”`}</span>
              {review.author && <span class="text-muted/70">{`— ${review.author}`}</span>}
              {/* The separator belongs to the item, so the line reads the same
                  across the seam where the second copy begins. */}
              <span class="pl-5 text-stone-warm" aria-hidden="true">•</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>
)}
