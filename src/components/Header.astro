---
import { t, localePath, stripLocale, locales, localeNames, sections, type Locale } from '../lib/i18n';
import BookNow from './BookNow.astro';
import Flag from './Flag.astro';

interface Props {
  locale: Locale;
  siteName: string;
  mewsConfigId?: string;
  overHero?: boolean;
}
const { locale, siteName, mewsConfigId, overHero = false } = Astro.props;
const tr = t(locale);
const basePath = stripLocale(Astro.url.pathname);
const home = localePath(locale, '/');
const navItems = sections.map((id) => ({ id, label: tr.nav[id] }));
---

<header class:list={['site-header', overHero && 'is-hero']} data-site-header data-home={home}>
  <!-- Utility bar (collapses on scroll) -->
  <div class="site-header__utility">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2 text-xs">
      <span class="hidden opacity-90 sm:inline">{tr.bookDirect}</span>
      <div class="flex items-center gap-2.5">
        {locales.map((l) => (
          <a
            href={localePath(l, basePath)}
            aria-label={localeNames[l]}
            title={localeNames[l]}
            class:list={['block transition-opacity', l === locale ? 'opacity-100' : 'opacity-45 hover:opacity-90']}
          >
            <Flag locale={l} class={l === locale ? 'h-3.5 w-5 ring-2 ring-current' : 'h-3.5 w-5'} />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Main navigation -->
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4">
    <a href={home} class="font-serif text-2xl tracking-wide">{siteName}</a>

    <nav class="hidden items-center gap-8 text-sm md:flex">
      {navItems.map((i) => (
        <a href={`#${i.id}`} data-section-link data-section={i.id} class="transition-opacity hover:opacity-60">
          {i.label}
        </a>
      ))}
      <a href={localePath(locale, '/faq')} class="transition-opacity hover:opacity-60">FAQ</a>
    </nav>

    <div class="flex items-center gap-3">
      <BookNow configId={mewsConfigId} label={tr.book} location="header" class="hidden sm:inline-flex !px-5 !py-2" />
      <button
        type="button"
        data-menu-toggle
        aria-label="Menu"
        aria-expanded="false"
        class="inline-flex h-10 w-10 items-center justify-center md:hidden"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="17" x2="21" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div data-mobile-menu class="hidden bg-paper text-ink shadow-lg md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-3 text-sm">
      {navItems.map((i) => (
        <a href={`#${i.id}`} data-section-link data-section={i.id} data-menu-link class="rounded px-2 py-2.5 hover:bg-sand">
          {i.label}
        </a>
      ))}
      <a href={localePath(locale, '/faq')} data-menu-link class="rounded px-2 py-2.5 hover:bg-sand">FAQ</a>
      <div class="px-2 pt-3">
        <BookNow configId={mewsConfigId} label={tr.book} location="mobile_menu" class="w-full justify-center" />
      </div>
      <div class="flex gap-3 px-2 pt-4">
        {locales.map((l) => (
          <a
            href={localePath(l, basePath)}
            aria-label={localeNames[l]}
            title={localeNames[l]}
            class:list={['transition-opacity', l === locale ? 'opacity-100' : 'opacity-45 hover:opacity-90']}
          >
            <Flag locale={l} class={l === locale ? 'h-4 w-6 ring-2 ring-clay' : 'h-4 w-6'} />
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const home = header?.dataset.home || '/';

  // Solid sticky header once scrolled past the top.
  const onScroll = () => {
    if (window.scrollY > 40) header?.setAttribute('data-scrolled', '');
    else header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Section links: scroll on the homepage, otherwise return home to the section.
  document.querySelectorAll<HTMLAnchorElement>('[data-section-link]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const id = link.dataset.section || '';
      if (!document.getElementById(id)) {
        e.preventDefault();
        window.location.href = `${home}#${id}`;
      }
    });
  });

  // Mobile menu toggle.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
  });
  document.querySelectorAll('[data-menu-link]').forEach((l) =>
    l.addEventListener('click', () => menu?.classList.add('hidden')),
  );
</script>
