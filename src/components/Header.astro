---
import { t, localePath, stripLocale, locales, localeNames, sections, type Locale } from '../lib/i18n';
import { translatePath } from '../lib/content';
import BookNow from './BookNow.astro';
import Flag from './Flag.astro';
import SideMenu from './SideMenu.astro';
import Logo from './Logo.astro';
import { collectionHref } from '../lib/partners';

interface Props {
  locale: Locale;
  siteName: string;
  mewsConfigId?: string;
  overHero?: boolean;
  /** Passed through to the side menu for its social links. */
  settings?: any;
}
const { locale, siteName, mewsConfigId, overHero = false, settings } = Astro.props;
const tr = t(locale);
const basePath = stripLocale(Astro.url.pathname);
const home = localePath(locale, '/');
// The bar's links scroll the homepage, except rooms, which goes to the room page
// instead: it is the one section that is only a summary of itself. The rail
// shows a handful of cards and loops, so someone reaching for "Rooms" wants the
// list rather than the part of the homepage that advertises it.
//
// Anything given a `page` stops being an anchor and stops carrying the
// scroll-spy attributes, which have nothing to point at once the link leaves the
// homepage.
const navItems = sections.map((id) => ({
  id,
  label: tr.nav[id],
  page: id === 'rooms' ? localePath(locale, '/rooms') : undefined,
}));

// Where each flag goes. Room and activity slugs can be translated, so this is a
// content lookup rather than just sticking a prefix on the current path.
const localeHrefs = Object.fromEntries(
  await Promise.all(
    locales.map(async (l) => [l, localePath(l, await translatePath(basePath, locale, l))] as const),
  ),
) as Record<Locale, string>;
---

<header class:list={['site-header intro-hide', overHero && 'is-hero']} data-site-header data-home={home}>
  <!-- Utility bar (collapses on scroll) -->
  <div class="site-header__utility">
    {/* Language only. `justify-end` rather than `justify-between`, which with a
        single child would push the flags to the left. */}
    <div class="mx-auto flex max-w-6xl items-center justify-end px-4 py-2 text-xs">
      <div class="flex items-center gap-2.5">
        {locales.map((l) => (
          <a
            href={localeHrefs[l]}
            aria-label={localeNames[l]}
            title={localeNames[l]}
            class:list={['block transition-opacity', l === locale ? 'opacity-100' : 'opacity-45 hover:opacity-90']}
          >
            <Flag locale={l} class={l === locale ? 'h-3.5 w-5 ring-2 ring-current' : 'h-3.5 w-5'} />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Main navigation -->
  <div class="site-header__bar mx-auto flex max-w-6xl items-center justify-between gap-6 px-4">
    {/* The wordmark, and the group it belongs to beside it. Two separate links,
        because one cannot nest inside the other, and the group opens away from
        the booking flow rather than navigating out of it.

        Colour is inherited rather than set: the bar is white over the hero and
        ink on paper, and the byline has to follow it in both. */}
    <div class="flex shrink-0 items-center gap-3">
      <a href={home} class="shrink-0" aria-label={siteName}>
        <Logo siteName={siteName} variant="auto" />
      </a>
      <a
        href={collectionHref(locale)}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden whitespace-nowrap text-[0.65rem] uppercase tracking-[0.18em] opacity-70 transition-opacity hover:opacity-100 sm:block"
      >
        {tr.byGroup}
      </a>
    </div>

    <nav class="hidden items-center gap-8 text-sm md:flex">
      {navItems.map((i) => (
        <a
          href={i.page ?? `#${i.id}`}
          data-section-link={i.page ? undefined : ''}
          data-section={i.page ? undefined : i.id}
          class="transition-opacity hover:opacity-60"
        >
          {i.label}
        </a>
      ))}
      <a href={localePath(locale, '/gallery')} class="transition-opacity hover:opacity-60">
        {tr.gallery.title}
      </a>
      <a href={localePath(locale, '/faq')} class="transition-opacity hover:opacity-60">FAQ</a>
    </nav>

    <div class="flex items-center gap-3">
      <BookNow configId={mewsConfigId} label={tr.book} location="header" class="hidden sm:inline-flex !px-5 !py-2" />
      {/* Opens the full site index. Shown at every width: on a narrow screen the
          bar has no links, and on a wide one this is the way to everything that
          does not fit in the bar. */}
      <button
        type="button"
        data-menu-toggle
        aria-label={tr.menu.open}
        aria-expanded="false"
        class="inline-flex h-10 w-10 items-center justify-center"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="17" x2="21" y2="17" />
        </svg>
      </button>
    </div>
  </div>

</header>

{/* The side panel replaces what used to be a separate mobile-only dropdown: one
    menu, at every width, listing the whole site rather than just the bar.

    Deliberately a sibling of the header, not a child. The header carries a
    `backdrop-filter` in its solid state, and that makes an element a containing
    block for `position: fixed` descendants: nested inside, this full-screen
    overlay was being sized to the header box instead of the viewport, so off the
    homepage it opened as a strip across the top. Its own z-index still puts it
    over the header. */}
<SideMenu locale={locale} siteName={siteName} mewsConfigId={mewsConfigId} settings={settings} />

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const home = header?.dataset.home || '/';

  // Solid sticky header once scrolled past the top.
  const onScroll = () => {
    if (window.scrollY > 40) header?.setAttribute('data-scrolled', '');
    else header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Section links: scroll on the homepage, otherwise return home to the section.
  document.querySelectorAll<HTMLAnchorElement>('[data-section-link]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const id = link.dataset.section || '';
      if (!document.getElementById(id)) {
        e.preventDefault();
        window.location.href = `${home}#${id}`;
      }
    });
  });

  // Side menu.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-side-menu]');

  if (toggle && menu) {
    const panel = menu.querySelector<HTMLElement>('.side-menu__panel')!;
    const closeBtn = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!;

    function openMenu() {
      menu!.setAttribute('data-open', '');
      toggle!.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closeMenu() {
      menu!.removeAttribute('data-open');
      toggle!.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggle!.focus();
    }

    const isOpen = () => menu.hasAttribute('data-open');

    toggle.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));
    closeBtn.addEventListener('click', closeMenu);
    menu.querySelector('[data-menu-backdrop]')?.addEventListener('click', closeMenu);

    // Following a link inside the panel should leave the panel shut behind you.
    // Same-page section links do not reload, so nothing else would close it.
    menu.querySelectorAll('[data-menu-link]').forEach((l) => l.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        closeMenu();
        return;
      }
      if (e.key !== 'Tab') return;
      // Keep Tab inside the panel rather than letting it walk the page behind.
      const stops = Array.from(
        panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ).filter((el) => el.offsetParent !== null);
      if (stops.length === 0) return;
      const edge = e.shiftKey ? stops[0] : stops[stops.length - 1];
      if (document.activeElement === edge) {
        e.preventDefault();
        (e.shiftKey ? stops[stops.length - 1] : stops[0]).focus();
      }
    });
  }
</script>
