---
/**
 * Aggregate guest review score over the hero, wearing the shared `hero-panel`
 * glass so it and the direct-booking badge in the opposite corner read as a
 * matched pair framing the photograph rather than as two unrelated boxes.
 *
 * That panel is the site's light glass, so the type here is ink, not white.
 *
 * The figures live in Site settings rather than in this file: a review score
 * moves every week, and it should be editable in Keystatic without a deploy.
 * The component renders nothing at all if the score is missing, so an empty
 * settings field simply removes the box.
 *
 * This is now the fallback rather than the usual case: the hero shows the
 * ReviewSlideshow when there are guest reviews to show, and drops back to this
 * single aggregate figure when the review list is empty.
 */
import Stars from './Stars.astro';
import { t, localeTags, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  score?: number | null;
  reviews?: number | null;
  source?: string | null;
  class?: string;
}
const { locale, score, reviews, source, class: className = '' } = Astro.props;
const tr = t(locale);

const tag = localeTags[locale];
const fmtScore = new Intl.NumberFormat(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const fmtCount = new Intl.NumberFormat(tag);

const scoreText = score == null ? '' : fmtScore.format(score);
const countText = reviews == null ? '' : fmtCount.format(reviews);
const label = [
  scoreText && `${scoreText}/10`,
  countText && `${countText} ${tr.reviewsLabel}`,
  source && `${tr.reviewsOn} ${source}`,
]
  .filter(Boolean)
  .join(' · ');
---

{score != null && (
  <div
    class:list={['hero-panel w-fit px-4 py-3.5 text-ink', className]}
    role="img"
    aria-label={label}
  >
    <div class="flex items-center gap-2">
      <Stars score={score} />
      <span class="text-sm font-medium leading-none text-ink">{scoreText}</span>
    </div>

    {(countText || source) && (
      <p class="mt-1.5 text-[0.65rem] font-medium uppercase tracking-[0.16em] text-muted" aria-hidden="true">
        {countText && `${countText} ${tr.reviewsLabel}`}
        {countText && source ? ' · ' : ''}
        {source}
      </p>
    )}
  </div>
)}
