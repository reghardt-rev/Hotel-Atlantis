---
/**
 * Guest reviews over the hero, one at a time.
 *
 * Replaces the single aggregate score box. It keeps that box's `hero-panel`
 * glass and its corner, so it and the direct-booking badge opposite still read
 * as a matched pair framing the photograph. The argument is unchanged, only the
 * evidence: a rotating quote from someone who stayed here says more than one
 * number does, and each slide still carries its own score so the number is not
 * lost.
 *
 * The quotes are edited at /keystatic under "Guest reviews": one list, with a
 * Dutch and a German translation hanging off each review, resolved by the
 * caller. A language left untranslated falls back to the English.
 *
 * Empty list, no panel: HomeView falls back to the aggregate ReviewScore box, so
 * the hero keeps its social proof until the first review is entered.
 *
 * Unlike the other hero overlays this one takes its own pointer events, because
 * a slideshow you cannot stop is a slideshow you cannot read. Pointing at it
 * holds the current quote and the dots step through by hand. The cost is that
 * this corner of the photograph no longer passes clicks through to the
 * carousel's change-slide half beneath it, which is a fair trade for a panel
 * this small.
 */
import Stars from './Stars.astro';
import { t, localeTags, type Locale } from '../lib/i18n';
import type { Review } from '../lib/content';

interface Props {
  locale: Locale;
  reviews: Review[];
  /** Credited under each quote, e.g. Booking.com. From Site settings. */
  source?: string | null;
  class?: string;
  /** Milliseconds a quote is held before the next one fades up. */
  interval?: number;
}
const { locale, reviews, source, class: className = '', interval = 5500 } = Astro.props;
const tr = t(locale);
const tag = localeTags[locale];
const fmtOne = new Intl.NumberFormat(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const fmtWhole = new Intl.NumberFormat(tag, { maximumFractionDigits: 0 });
// One decimal, as every OTA writes them, except a perfect score: Booking.com
// says 10, not 10.0, and so should this.
const fmtScore = (n: number) => (n >= 10 ? fmtWhole.format(n) : fmtOne.format(n));

const credit = (review: Review) => [review.author, source].filter(Boolean).join(' · ');
---

{reviews.length > 0 && (
  <div
    class:list={[
      'hero-panel pointer-events-auto w-fit max-w-[18rem] px-4 py-3.5 text-ink',
      className,
    ]}
    data-reviews
    data-interval={interval}
  >
    {/* Every slide sits in the same grid cell, so the panel is as tall as the
        longest quote from the first paint and never resizes mid-rotation.
        Absolute positioning would have collapsed it to nothing instead. */}
    <div class="grid">
      {reviews.map((review, i) => (
        <figure
          class="col-start-1 row-start-1 transition-opacity duration-500"
          style={`opacity:${i === 0 ? 1 : 0}`}
          data-review-slide
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <div class="flex items-center gap-2">
            <Stars score={review.score} />
            {/* Said in words as well as drawn, since the stars are decorative
                and this line is what a screen reader has to work from. */}
            <span class="text-sm font-medium leading-none text-ink">
              <span class="sr-only">{`${fmtScore(review.score)}/10`}</span>
              <span aria-hidden="true">
                {fmtScore(review.score)}<span class="text-muted">/10</span>
              </span>
            </span>
          </div>

          {/* Clamped rather than trusted: the panel hangs over a photograph on a
              phone as well, and one guest writing an essay must not push the
              booking bar off the screen. Six lines is about 240 characters at
              this width, which takes a real Booking.com review whole; clipping
              one mid-sentence looks worse than a slightly taller panel. Keep the
              quotes to roughly that in Keystatic and this never bites. */}
          <blockquote class="mt-2 line-clamp-6 text-[0.8rem] leading-snug text-ink">
            {review.text}
          </blockquote>

          {credit(review) && (
            <figcaption class="mt-2 text-[0.65rem] font-medium uppercase tracking-[0.16em] text-muted">
              {credit(review)}
            </figcaption>
          )}
        </figure>
      ))}
    </div>

    {reviews.length > 1 && (
      <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5">
        {reviews.map((_, i) => (
          <button
            type="button"
            data-review-dot
            aria-label={tr.reviewGoTo.replace('{n}', String(i + 1))}
            aria-current={i === 0 ? 'true' : 'false'}
            class:list={[
              'h-1.5 w-1.5 cursor-pointer rounded-full transition-colors',
              i === 0 ? 'bg-clay' : 'bg-ink/25',
            ]}
          />
        ))}
      </div>
    )}
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-review-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-review-dot]'));
    // One review is a static quote, not a slideshow. Leave the markup as the
    // server rendered it rather than starting a timer that changes nothing.
    if (slides.length < 2) return;

    const interval = Number(root.dataset.interval) || 5500;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function show(n: number) {
      index = (n + slides.length) % slides.length;
      slides.forEach((slide, k) => {
        const on = k === index;
        slide.style.opacity = on ? '1' : '0';
        // The quotes all stay in the document, so a search engine sees the lot.
        // Hiding the inactive ones from the accessibility tree stops a screen
        // reader reading all ten of them in a row.
        if (on) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, k) => {
        dot.classList.toggle('bg-clay', k === index);
        dot.classList.toggle('bg-ink/25', k !== index);
        dot.setAttribute('aria-current', k === index ? 'true' : 'false');
      });
    }

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      // Reduced motion gets the first quote and no rotation. The dots still
      // work, so every review is still reachable by hand.
      if (reduce) return;
      stop();
      timer = setInterval(() => show(index + 1), interval);
    };

    dots.forEach((dot, k) => dot.addEventListener('click', () => (show(k), start())));
    // Pointing at the panel is someone trying to finish the quote, so hold it
    // there. Same for tabbing into the dots.
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    // Nothing to read while the tab is in the background, and a timer left
    // running there means coming back to a quote mid-fade.
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    start();
  });
</script>
