---
/**
 * The homepage room list, as one edge-to-edge run scrolled sideways.
 *
 * Native scrolling with CSS snap points rather than a scripted slider: it works
 * with a touchpad, a swipe and a screen reader's own scrolling before any of
 * this component's JavaScript has run, and the arrows below are a convenience on
 * top of that rather than the mechanism. Every card is a link, so tabbing
 * through them scrolls the rail without help.
 *
 * The heading above and the controls below stay in the content column; only the
 * rail itself is full width.
 */
import RoomCard from './RoomCard.astro';
import { t, localePath, type Locale } from '../lib/i18n';

interface Props {
  rooms: { slug: string; entry: any; photos?: { src: string; alt: string }[] }[];
  locale: Locale;
}
const { rooms, locale } = Astro.props;
const tr = t(locale);
---

<section id="rooms" class="py-20 sm:py-28" data-room-carousel>
  {/* Heading and the way through to the full list on one line, as the offers
      and activities sections do it. The link sits with the heading rather than
      under the rail because it is an alternative to scrolling, not the thing
      you arrive at once you have finished: a reader who would rather see all
      seven rooms as a page should not have to travel the run to find that out. */}
  <div class="reveal mx-auto flex max-w-6xl flex-wrap items-end justify-between gap-4 px-4">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-clay">{tr.nav.rooms}</p>
      <h2 class="mt-3 font-serif text-4xl sm:text-5xl">{tr.ourRooms}</h2>
    </div>
    <a href={localePath(locale, '/rooms')} class="text-sm font-medium text-clay hover:underline">
      {tr.allRooms} →
    </a>
  </div>

  {/* The rail arrives as one object, not as a group: its cards already carry
      an inline transform from the depth pass below, and a reveal transform on
      each of them would be overwritten the first time the rail is scrolled. */}
  <div class="reveal room-rail mt-10" data-room-rail>
    {rooms.map((room) => <RoomCard room={room} locale={locale} aspect="wide" />)}
  </div>

  {/* Only the arrows now, out at the right where the run ends and the reader's
      hand already is. The row is the nav: with the full-list link moved up to
      the heading there is nothing else in here, so hiding it has to take the
      top margin with it or an empty band is left under the rail.

      Hidden until the script confirms the rail actually overflows, since on a
      wide screen with few rooms there is nothing to scroll to, and below `sm`,
      where the rail is swiped rather than stepped. The `hidden` attribute wins
      over `sm:flex` on its own: Tailwind's preflight sets it `!important`. */}
  <div
    class="mx-auto mt-8 hidden max-w-6xl items-center justify-end gap-2 px-4 sm:flex"
    data-rail-nav
    hidden
  >
    <button type="button" class="rail-nav" data-rail-prev aria-label={tr.scrollPrev}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>
    <button type="button" class="rail-nav" data-rail-next aria-label={tr.scrollNext}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
        <path d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-room-carousel]');
  const rail = root?.querySelector<HTMLElement>('[data-room-rail]');

  if (root && rail) {
    const nav = root.querySelector<HTMLElement>('[data-rail-nav]');
    const prev = root.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-rail-next]');
    const originals = Array.from(rail.children) as HTMLElement[];

    // Width of one full run of rooms. Measured after the copies are in place, as
    // the distance between the first copy and the first original, so it holds
    // whatever the cards happen to be sized at.
    let unit = 0;
    let looping = false;

    // The rail loops by carrying a copy of the run on either side of the real
    // one and jumping back a run's width whenever a copy is scrolled into. The
    // jump is the same distance as the pattern repeats, so nothing moves on
    // screen. Copies are hidden from assistive tech and taken out of the tab
    // order: they are the same twelve rooms, and should be announced once.
    function copyOf(node: HTMLElement) {
      const copy = node.cloneNode(true) as HTMLElement;
      copy.setAttribute('aria-hidden', 'true');
      copy.setAttribute('tabindex', '-1');
      copy
        .querySelectorAll<HTMLElement>('a, button')
        .forEach((el) => el.setAttribute('tabindex', '-1'));
      return copy;
    }

    function jumpTo(x: number) {
      // Instant, or the wrap would animate across the whole run.
      const previous = rail!.style.scrollBehavior;
      rail!.style.scrollBehavior = 'auto';
      rail!.scrollLeft = x;
      rail!.style.scrollBehavior = previous;
    }

    function setupLoop() {
      if (looping || originals.length === 0) return;
      // Nothing to loop through if the run already fits.
      if (rail!.scrollWidth <= rail!.clientWidth + 2) return;

      rail!.prepend(...originals.map(copyOf));
      rail!.append(...originals.map(copyOf));
      looping = true;
      // Mandatory snapping is only safe once the run repeats: see the note on
      // `is-looping` in global.css.
      rail!.classList.add('is-looping');
      measure();
      jumpTo(unit);
    }

    function measure() {
      if (!looping) return;
      const firstCopy = rail!.firstElementChild as HTMLElement | null;
      if (firstCopy) unit = originals[0].offsetLeft - firstCopy.offsetLeft;
    }

    // Bring the scroll back inside the middle run. Modulo rather than a single
    // ±unit correction: one flick of a trackpad can cover more than a whole run,
    // and a single correction would leave it outside the window still, to be
    // corrected again on the next event.
    function wrap() {
      if (!looping || unit <= 0) return;
      const at = rail!.scrollLeft;
      const low = unit * 0.5;
      const wrapped = low + ((((at - low) % unit) + unit) % unit);
      // Sub-pixel differences are the browser's own rounding, not a wrap.
      if (Math.abs(wrapped - at) > 1) jumpTo(wrapped);
    }

    /* The wrap waits for the scroll to stop, unless a drag is driving it.
     *
     * A flick on a trackpad hands the scroll to the browser's own inertia, which
     * is gliding towards a target it worked out before we touched anything.
     * Moving `scrollLeft` underneath that does not cancel it: the glide carries
     * on to where it was already going, which is now a run away from where the
     * content is, and the next wrap hauls it back. That fight is the juddering
     * you get on a fast swipe. Waiting for the scroll to finish costs nothing:
     * the copies either side are a full run each, some four screens' worth, and
     * no single flick crosses one.
     *
     * A pointer drag is the exception. It sets `scrollLeft` from its own deltas
     * on every move, so a jump mid-drag is invisible to it — and deferring there
     * would let a long drag run off the end of the copies.
     */
    let settle: ReturnType<typeof setTimeout> | undefined;
    function wrapWhenSettled() {
      if (rail!.classList.contains('is-dragging')) {
        wrap();
        return;
      }
      // Flicks landing on top of one another never let the scroll settle, and
      // each one spends more of the runway. Close enough to a real end, take the
      // judder: it is the only thing left between the reader and a rail that
      // stops dead in the middle of a gesture.
      const at = rail!.scrollLeft;
      const end = rail!.scrollWidth - rail!.clientWidth;
      if (at < unit * 0.15 || at > end - unit * 0.15) {
        clearTimeout(settle);
        wrap();
        return;
      }
      clearTimeout(settle);
      settle = setTimeout(wrap, 140);
    }

    // One card plus the gap between them, measured rather than assumed: the card
    // width is a clamp() and the gap is a rem, so neither is known here.
    function step() {
      const card = rail!.firstElementChild as HTMLElement | null;
      if (!card) return rail!.clientWidth;
      const gap = parseFloat(getComputedStyle(rail!).columnGap) || 0;
      return card.offsetWidth + gap;
    }

    function sync() {
      const max = rail!.scrollWidth - rail!.clientWidth;
      nav?.toggleAttribute('hidden', max <= 2);
      // A looping rail always has somewhere to go in both directions.
      if (looping) {
        if (prev) prev.disabled = false;
        if (next) next.disabled = false;
        return;
      }
      // A couple of pixels of slack: scrollLeft is fractional on a scaled
      // display and lands just shy of the end, which would otherwise leave
      // "next" enabled with nowhere left to go.
      const at = rail!.scrollLeft;
      if (prev) prev.disabled = at <= 2;
      if (next) next.disabled = at >= max - 2;
    }

    prev?.addEventListener('click', () => rail.scrollBy({ left: -step() }));
    next?.addEventListener('click', () => rail.scrollBy({ left: step() }));

    /* ---- Depth -------------------------------------------------------------
     * Cards shrink and fade towards the ends of the rail and come up to full
     * size as they reach the middle, so the run reads as carrying on past both
     * edges of the window rather than stopping at them.
     *
     * Measured off each card against the rail's own box, so it covers the loop's
     * clones without knowing they exist, and holds at any card width the clamp
     * settles on. The falloff runs over one card width in from each edge: wider
     * and cards start dimming while they are still plainly in the middle of the
     * rail, narrower and they snap.
     *
     * Scroll driven rather than played, like everything else on this page, so
     * dragging the rail works it in both directions and it always matches where
     * the rail actually is. `transform` and `opacity` only, so nothing here
     * moves the layout or disturbs the scroll positions the loop depends on.
     */
    /* How far a card off-centre is shrunk and faded.
     *
     * Two settings, because the rail is two different things. On a wide screen
     * three cards are on show and the falloff is what makes the middle one the
     * subject; a neighbour at 0.4 is scenery and reads as such.
     *
     * On a phone the only thing off-centre is the sliver of the next room, and
     * scenery is exactly what it must not be: that sliver is the entire signal
     * that the rail scrolls at all. At 0.4 it was a grey smudge against the page
     * and easy to miss. 0.78 keeps it plainly a photograph of another room while
     * still sitting behind the one in front.
     */
    const narrow = window.matchMedia('(max-width: 639px)');
    const minScale = () => (narrow.matches ? 0.94 : 0.86);
    const minFade = () => (narrow.matches ? 0.78 : 0.4);
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let depthQueued = false;

    function depth() {
      depthQueued = false;
      const box = rail!.getBoundingClientRect();
      for (const node of Array.from(rail!.children) as HTMLElement[]) {
        const card = node.getBoundingClientRect();
        if (card.width === 0) continue;
        const middle = card.left + card.width / 2;
        const fromEdge = Math.min(middle - box.left, box.right - middle);
        // The falloff runs over one card width in from each edge, which works
        // while the rail is wider than two cards. On a phone it is not: the card
        // is most of the screen, so its centre can never get a full card width
        // from the nearer edge, `t` topped out around 0.6, and every card sat
        // permanently at 77% opacity with none ever reading as the one being
        // looked at. Capping the ramp at half the rail makes the middle of a
        // narrow rail fully lit, and changes nothing on a wide one, where half
        // the rail is already the larger of the two.
        const ramp = Math.min(card.width, box.width / 2);
        const t = fromEdge <= 0 ? 0 : fromEdge >= ramp ? 1 : fromEdge / ramp;
        const lowScale = minScale();
        const lowFade = minFade();
        node.style.transform = `scale(${(lowScale + (1 - lowScale) * t).toFixed(4)})`;
        node.style.opacity = (lowFade + (1 - lowFade) * t).toFixed(3);
      }
    }

    function queueDepth() {
      // Reduced motion keeps every card at full size: this is decoration, and it
      // is the kind that moves.
      if (still || depthQueued) return;
      depthQueued = true;
      requestAnimationFrame(depth);
    }

    rail.addEventListener(
      'scroll',
      () => {
        wrapWhenSettled();
        sync();
        queueDepth();
      },
      { passive: true },
    );
    // Where it exists, the browser says when the scroll has finished — including
    // the end of an inertial glide and of the arrows' smooth scroll. The timer
    // above is the fallback for browsers that do not fire it; both landing is
    // harmless, since a wrap that is already inside the window does nothing.
    rail.addEventListener('scrollend', wrap, { passive: true });
    // Crossing the breakpoint changes both depth settings, so redraw at it.
    narrow.addEventListener('change', queueDepth);
    window.addEventListener(
      'resize',
      () => {
        measure();
        sync();
        queueDepth();
      },
      { passive: true },
    );

    /* ---- Drag --------------------------------------------------------------
     * Pulling the rail sideways with the mouse, which otherwise has no way to
     * move it but the two arrows: the rail is a scroll container, so a finger
     * already drags it, with momentum and snapping that nothing written here
     * would improve on. Hence mouse only, rather than the pointer-type-agnostic
     * gesture the hero carousel runs. The hero has no native scrolling to
     * preserve; this does, and taking it over would be a downgrade on a phone.
     */
    const DRAG_MIN = 6; // px of travel before a press counts as a drag

    let pointer: number | null = null;
    let startX = 0;
    let startY = 0;
    let lastX = 0;
    let dragging = false;
    let dragged = false;
    let unarm: ReturnType<typeof setTimeout> | undefined;

    function endDrag() {
      if (pointer === null) return;
      pointer = null;
      if (!dragging) return;
      dragging = false;
      rail!.classList.remove('is-dragging');
      // Arm the click guard below. Disarmed on a timer as well as by the click,
      // because a drag does not reliably end in one: release outside the rail
      // and no click is generated at all, and a guard left armed would go on to
      // swallow an unrelated click later.
      dragged = true;
      clearTimeout(unarm);
      unarm = setTimeout(() => (dragged = false), 400);
    }

    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button > 0) return;
      pointer = e.pointerId;
      startX = lastX = e.clientX;
      startY = e.clientY;
      dragged = false;
    });

    rail.addEventListener('pointermove', (e) => {
      if (pointer !== e.pointerId) return;

      if (!dragging) {
        // Held until the movement is both far enough to be deliberate and more
        // sideways than not, so a press that turns into a page scroll, or a
        // plain click on a card, is left alone.
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        if (Math.abs(dx) < DRAG_MIN || Math.abs(dx) <= Math.abs(dy)) return;
        dragging = true;
        rail!.classList.add('is-dragging');
        // As on the hero: the class, and the `user-select` guard with it, only
        // lands once the drag is recognised, by which point the browser may have
        // started selecting from where the press began. Clear what it caught.
        window.getSelection()?.removeAllRanges();
        try {
          // Keeps the gesture alive when the pointer leaves the rail mid-drag.
          // Not worth losing the drag over if the pointer has already gone.
          rail!.setPointerCapture(e.pointerId);
        } catch {
          /* no capture, but the drag still tracks while the pointer is here */
        }
      }

      // Applied as a delta against wherever the rail is now, never as an offset
      // from where the drag started. The loop jumps `scrollLeft` by a whole run
      // the moment a copy is scrolled into, and an absolute figure would undo
      // that jump on the very next move and strand the drag inside the copies.
      rail!.scrollLeft -= e.clientX - lastX;
      lastX = e.clientX;
    });

    rail.addEventListener('pointerup', endDrag);
    rail.addEventListener('pointercancel', endDrag);

    // A drag that happens to finish on a card must not also open that room.
    // Captured, so it is stopped before it reaches the link inside.
    rail.addEventListener(
      'click',
      (e) => {
        if (!dragged) return;
        dragged = false;
        clearTimeout(unarm);
        e.preventDefault();
        e.stopPropagation();
      },
      true,
    );

    // Or the browser picks up the photograph, or the link around it, and drags
    // its own ghost of the thing across the page instead of running the above.
    rail.addEventListener('dragstart', (e) => e.preventDefault());

    setupLoop();
    sync();
    // After the loop, so the clones it prepends are sized with everything else
    // rather than sitting at full size until the first scroll.
    queueDepth();
  }
</script>
