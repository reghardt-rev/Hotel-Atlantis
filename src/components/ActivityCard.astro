---
import { t, localePath, formatDate, type Locale } from '../lib/i18n';

interface Props {
  activity: { slug: string; entry: any };
  locale: Locale;
}
const { activity, locale } = Astro.props;
const tr = t(locale);
const e = activity.entry;
const href = localePath(locale, `/activities/${activity.slug}`);
---

<article class="group flex flex-col">
  <a href={href} class="block aspect-[4/3] overflow-hidden rounded-xl bg-gradient-to-br from-stone-warm to-sand">
    {e.image && (
      <img
        src={e.image}
        alt={e.title}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    )}
  </a>
  {e.publishedAt && <p class="mt-5 text-xs text-muted">{formatDate(locale, e.publishedAt)}</p>}
  <h3 class="mt-2 font-serif text-2xl">
    <a href={href} class="hover:text-clay">{e.title}</a>
  </h3>
  {e.summary && <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{e.summary}</p>}
  <a href={href} class="mt-4 text-sm font-medium text-clay hover:underline">{tr.readMore} →</a>
</article>
