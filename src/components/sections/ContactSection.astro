---
import type { Locale } from '../../lib/i18n';
interface Props {
  locale: Locale;
  settings: any;
}
const { locale, settings } = Astro.props;
const c = {
  en: {
    nlKicker: 'Stay in touch',
    nlTitle: 'Our newsletter',
    nlBody: 'Occasional news, offers and things worth doing in the city. No noise.',
    placeholder: 'Your email address',
    subscribe: 'Sign up',
    thanks: 'Thank you — we’ll be in touch.',
    contactTitle: 'Contact',
    directions: 'Get directions',
  },
  nl: {
    nlKicker: 'Blijf op de hoogte',
    nlTitle: 'Onze nieuwsbrief',
    nlBody: 'Af en toe nieuws, aanbiedingen en tips uit de stad. Geen ruis.',
    placeholder: 'Uw e-mailadres',
    subscribe: 'Aanmelden',
    thanks: 'Dank u — we nemen contact op.',
    contactTitle: 'Contact',
    directions: 'Route',
  },
  de: {
    nlKicker: 'Bleiben Sie in Kontakt',
    nlTitle: 'Unser Newsletter',
    nlBody: 'Gelegentlich Neuigkeiten, Angebote und Tipps aus der Stadt. Kein Lärm.',
    placeholder: 'Ihre E-Mail-Adresse',
    subscribe: 'Anmelden',
    thanks: 'Vielen Dank — wir melden uns.',
    contactTitle: 'Kontakt',
    directions: 'Route',
  },
}[locale];
const address = settings?.address as string | undefined;
const mapsHref = address
  ? `https://maps.google.com/?q=${encodeURIComponent(address.replace(/\n/g, ', '))}`
  : undefined;
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
  <div class="grid gap-12 lg:grid-cols-2">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-clay">{c.nlKicker}</p>
      <h2 class="mt-4 font-serif text-4xl sm:text-5xl">{c.nlTitle}</h2>
      <p class="mt-4 text-lg text-muted">{c.nlBody}</p>
      <form data-newsletter class="mt-6 flex max-w-md flex-col gap-3 sm:flex-row">
        <input
          type="email"
          name="email"
          required
          placeholder={c.placeholder}
          class="w-full rounded-full border border-stone-warm bg-white px-5 py-3 text-sm outline-none focus:border-clay"
        />
        <button
          type="submit"
          class="shrink-0 cursor-pointer rounded-full bg-clay px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-clay-dark"
        >{c.subscribe}</button>
      </form>
      <p data-newsletter-thanks hidden class="mt-3 text-sm text-clay">{c.thanks}</p>
    </div>

    <div class="lg:pl-12">
      <h2 class="font-serif text-4xl sm:text-5xl">{c.contactTitle}</h2>
      <div class="mt-6 space-y-2 text-muted">
        {address && <p class="whitespace-pre-line">{address}</p>}
        {settings?.phone && (
          <p><a href={`tel:${settings.phone}`} class="hover:text-ink">{settings.phone}</a></p>
        )}
        {settings?.email && (
          <p><a href={`mailto:${settings.email}`} class="hover:text-ink">{settings.email}</a></p>
        )}
      </div>
      {mapsHref && (
        <a href={mapsHref} target="_blank" rel="noopener" class="mt-5 inline-block text-sm font-medium text-clay hover:underline">
          {c.directions} →
        </a>
      )}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.hidden = true;
      const thanks = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-thanks]');
      if (thanks) thanks.hidden = false;
    });
  });
</script>
