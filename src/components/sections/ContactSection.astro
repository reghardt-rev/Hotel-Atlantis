---
import type { Locale } from '../../lib/i18n';
import { mapsHref } from '../../lib/maps';
interface Props {
  locale: Locale;
  settings: any;
}
const { locale, settings } = Astro.props;
const c = {
  en: { contactTitle: 'Contact', directions: 'Get directions' },
  nl: { contactTitle: 'Contact', directions: 'Route' },
  de: { contactTitle: 'Kontakt', directions: 'Route' },
}[locale];
const address = settings?.address as string | undefined;
const directions = mapsHref(settings);
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
  {/* One column now that the newsletter has gone. It arrives from the left like
      every other block on the page: with nothing travelling in from the right,
      the section needs no `reveal-frame` to clip it and does not have one. */}
  <div class="reveal max-w-2xl">
    <h2 class="font-serif text-4xl sm:text-5xl">{c.contactTitle}</h2>
    <div class="mt-6 space-y-2 text-muted">
      {address && <p class="whitespace-pre-line">{address}</p>}
      {settings?.phone && (
        <p><a href={`tel:${settings.phone}`} class="hover:text-ink">{settings.phone}</a></p>
      )}
      {settings?.email && (
        <p><a href={`mailto:${settings.email}`} class="hover:text-ink">{settings.email}</a></p>
      )}
    </div>
    {directions && (
      <a href={directions} target="_blank" rel="noopener" class="mt-5 inline-block text-sm font-medium text-clay hover:underline">
        {c.directions} →
      </a>
    )}
  </div>
</section>
