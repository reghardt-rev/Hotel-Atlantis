---
import type { Locale } from '../../lib/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = {
  en: {
    kicker: 'Welcome to Hotel Atlantis',
    title: 'Find your place in the city',
    body: [
      'Hotel Atlantis is more than a place to sleep. It is a base in De Pijp, a few streets outside the canal ring, where the market, the museums and the tram are all a short walk from the front door.',
      'Reception is staffed day and night, so there is always someone to point you towards a table, a ticket or the quickest way across town. Book direct and you get our best rate.',
    ],
  },
  nl: {
    kicker: 'Welkom bij Hotel Atlantis',
    title: 'Vind uw plek in de stad',
    body: [
      'Hotel Atlantis is meer dan een plek om te slapen. Het is een uitvalsbasis in De Pijp, een paar straten buiten de grachtengordel, met de markt, de musea en de tram op loopafstand van de voordeur.',
      'De receptie is dag en nacht bezet, dus er is altijd iemand die u de weg wijst naar een tafel, een ticket of de snelste route door de stad. Boek direct voor onze beste prijs.',
    ],
  },
  de: {
    kicker: 'Willkommen im Hotel Atlantis',
    title: 'Finden Sie Ihren Platz in der Stadt',
    body: [
      'Das Hotel Atlantis ist mehr als nur eine Übernachtung. Es ist ein Ausgangspunkt in De Pijp, wenige Straßen außerhalb des Grachtengürtels, mit Markt, Museen und Tram in Gehweite der Haustür.',
      'Die Rezeption ist Tag und Nacht besetzt, es ist also immer jemand da, der Ihnen einen Tisch, ein Ticket oder den schnellsten Weg durch die Stadt zeigt. Buchen Sie direkt für unseren besten Preis.',
    ],
  },
}[locale];
---

<section id="welcome" class="mx-auto max-w-3xl px-4 py-20 text-center sm:py-28">
  <p class="text-xs uppercase tracking-[0.3em] text-clay">{c.kicker}</p>
  <h2 class="mt-5 font-serif text-4xl leading-tight sm:text-5xl">{c.title}</h2>
  {c.body.map((p) => <p class="mt-5 text-lg leading-relaxed text-muted">{p}</p>)}
</section>
