---
import type { Locale } from '../../lib/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = {
  en: {
    kicker: 'Amsterdam & De Pijp',
    title: 'A bustling neighbourhood in the heart of De Pijp',
    body: 'De Pijp is where Amsterdam does its daily shopping and lingers over coffee. The Albert Cuypmarkt runs along the next street, the Museumplein is five minutes by tram, and the canal ring begins just north of here. Reception can arrange museum tickets, a canal cruise or a bike whenever you need one.',
    near: [
      { t: 'Albert Cuypmarkt', d: 'Daily market, a short walk away' },
      { t: 'Museumplein', d: 'Rijksmuseum, Van Gogh and Moco' },
      { t: 'Dam Square', d: 'The historic centre, about fifteen minutes' },
      { t: 'Amsterdam RAI', d: 'Eight minutes by tram or bike' },
    ],
  },
  nl: {
    kicker: 'Amsterdam & De Pijp',
    title: 'Een bruisende buurt in het hart van De Pijp',
    body: 'In De Pijp doet Amsterdam zijn dagelijkse boodschappen en blijft het hangen bij de koffie. De Albert Cuypmarkt loopt door de volgende straat, het Museumplein is vijf minuten met de tram en de grachtengordel begint net ten noorden hiervan. De receptie regelt museumtickets, een rondvaart of een fiets wanneer u er een nodig heeft.',
    near: [
      { t: 'Albert Cuypmarkt', d: 'Dagelijkse markt, op loopafstand' },
      { t: 'Museumplein', d: 'Rijksmuseum, Van Gogh en Moco' },
      { t: 'De Dam', d: 'Het historische centrum, ongeveer vijftien minuten' },
      { t: 'Amsterdam RAI', d: 'Acht minuten met de tram of de fiets' },
    ],
  },
  de: {
    kicker: 'Amsterdam & De Pijp',
    title: 'Ein lebendiges Viertel im Herzen von De Pijp',
    body: 'In De Pijp erledigt Amsterdam seine täglichen Einkäufe und bleibt beim Kaffee sitzen. Der Albert-Cuyp-Markt zieht sich durch die nächste Straße, das Museumplein ist fünf Minuten mit der Tram entfernt, und der Grachtengürtel beginnt gleich nördlich von hier. Die Rezeption vermittelt Museumstickets, eine Grachtenfahrt oder ein Fahrrad, wann immer Sie eines brauchen.',
    near: [
      { t: 'Albert-Cuyp-Markt', d: 'Täglicher Markt, wenige Gehminuten entfernt' },
      { t: 'Museumplein', d: 'Rijksmuseum, Van Gogh und Moco' },
      { t: 'Dam', d: 'Das historische Zentrum, etwa fünfzehn Minuten' },
      { t: 'Amsterdam RAI', d: 'Acht Minuten mit Tram oder Fahrrad' },
    ],
  },
}[locale];
---

<section id="location" class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
  <div class="max-w-2xl">
    <p class="text-xs uppercase tracking-[0.3em] text-clay">{c.kicker}</p>
    <h2 class="mt-4 font-serif text-4xl sm:text-5xl">{c.title}</h2>
    <p class="mt-5 text-lg leading-relaxed text-muted">{c.body}</p>
  </div>
  <div class="mt-12 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
    {c.near.map((n) => (
      <div class="border-t border-stone-warm pt-4">
        <p class="font-medium">{n.t}</p>
        <p class="mt-1 text-sm text-muted">{n.d}</p>
      </div>
    ))}
  </div>
</section>
