---
/**
 * Homepage activities section. Features the most recently published activity
 * and links through to the full list. The nav's "Activities" tab scrolls here.
 */
import { listActivities } from '../../lib/content';
import { t, localePath, formatDate, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);

const activities = await listActivities(locale);
const latest = activities[0];
const e = latest?.entry;
const href = latest ? localePath(locale, `/activities/${latest.slug}`) : '';
---

<section id="activities" class="bg-sand">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
    {latest ? (
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div class="aspect-[4/3] overflow-hidden rounded-xl bg-gradient-to-br from-stone-warm to-sand">
          {e.image && (
            <img src={e.image} alt={e.title} class="h-full w-full object-cover" loading="lazy" decoding="async" />
          )}
        </div>
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-clay">{tr.nav.activities}</p>
          <h2 class="mt-4 font-serif text-4xl sm:text-5xl">{e.title}</h2>
          {e.publishedAt && (
            <p class="mt-3 text-sm text-muted">{formatDate(locale, e.publishedAt)}</p>
          )}
          {e.summary && <p class="mt-5 text-lg leading-relaxed text-muted">{e.summary}</p>}

          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a
              href={href}
              class="inline-flex items-center justify-center rounded-full bg-clay px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-clay-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2"
            >
              {tr.readMore}
            </a>
            <a
              href={localePath(locale, '/activities')}
              class="text-sm font-medium text-clay hover:underline"
            >
              {tr.allActivities} →
            </a>
          </div>
        </div>
      </div>
    ) : (
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-clay">{tr.nav.activities}</p>
        <h2 class="mt-3 font-serif text-4xl sm:text-5xl">{tr.ourActivities}</h2>
        <p class="mt-5 text-muted">{tr.noActivities}</p>
      </div>
    )}
  </div>
</section>
