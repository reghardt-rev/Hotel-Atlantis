---
import type { Locale } from '../../lib/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const items = {
  en: [
    { t: 'Book direct', d: 'Our best rate, guaranteed' },
    { t: 'Reception around the clock', d: 'Someone here day and night' },
    { t: 'Albert Cuypmarkt', d: 'Around the corner on foot' },
    { t: 'Museumplein', d: 'Five minutes by tram' },
  ],
  nl: [
    { t: 'Direct boeken', d: 'Onze beste prijs, gegarandeerd' },
    { t: 'Receptie 24/7', d: 'Dag en nacht iemand aanwezig' },
    { t: 'Albert Cuypmarkt', d: 'Om de hoek, te voet' },
    { t: 'Museumplein', d: 'Vijf minuten met de tram' },
  ],
  de: [
    { t: 'Direkt buchen', d: 'Unser bester Preis, garantiert' },
    { t: 'Rezeption rund um die Uhr', d: 'Tag und Nacht besetzt' },
    { t: 'Albert-Cuyp-Markt', d: 'Um die Ecke, zu Fuß' },
    { t: 'Museumplein', d: 'Fünf Minuten mit der Tram' },
  ],
}[locale];
---

<section class="border-b border-stone-warm bg-sand">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-6 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((c) => (
      <div class="flex items-start gap-3">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-clay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <div>
          <p class="text-sm font-medium">{c.t}</p>
          <p class="text-xs text-muted">{c.d}</p>
        </div>
      </div>
    ))}
  </div>
</section>
