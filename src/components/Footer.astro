---
import SocialIcon from './SocialIcon.astro';
import RevenueGuruMark from './RevenueGuruMark.astro';
import { socialLinks } from '../lib/social';
import { t, localePath, sectionHref, sections, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  settings: any;
}
const { locale, settings } = Astro.props;
const tr = t(locale);
const year = new Date().getFullYear();
const siteName = settings?.siteName ?? 'Hotel Atlantis';
const navItems = sections.map((id) => ({ href: sectionHref(locale, id), label: tr.nav[id] }));
const links = socialLinks(settings);
---

<footer class="bg-ink text-paper">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-serif text-3xl">{siteName}</p>
      {settings?.tagline && <p class="mt-3 max-w-sm text-sm text-paper/70">{settings.tagline}</p>}
    </div>

    <nav class="space-y-2 text-sm">
      {navItems.map((i) => (
        <a href={i.href} class="block text-paper/80 transition-colors hover:text-paper">{i.label}</a>
      ))}
      <a href={localePath(locale, '/rooms')} class="block text-paper/80 transition-colors hover:text-paper">
        {tr.allRooms}
      </a>
      <a href={localePath(locale, '/faq')} class="block text-paper/80 transition-colors hover:text-paper">FAQ</a>
      <a href={localePath(locale, '/privacy')} class="block text-paper/80 transition-colors hover:text-paper">
        {tr.privacy}
      </a>
    </nav>

    <div class="space-y-1 text-sm text-paper/80">
      {settings?.address && <p class="whitespace-pre-line">{settings.address}</p>}
      {settings?.phone && (
        <p><a href={`tel:${settings.phone}`} class="hover:text-paper">{settings.phone}</a></p>
      )}
      {settings?.email && (
        <p><a href={`mailto:${settings.email}`} class="hover:text-paper">{settings.email}</a></p>
      )}
      {links.length > 0 && (
        <div class="flex flex-wrap gap-4 pt-3">
          {links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="text-paper/70 transition-colors hover:text-paper"
            >
              <SocialIcon name={link.key} />
            </a>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="flex flex-col items-center gap-2 border-t border-paper/10 py-5 text-center text-xs text-paper/50 sm:flex-row sm:justify-center sm:gap-4">
    <span>© {year} {siteName}</span>
    <button type="button" data-cookie-settings class="cursor-pointer underline transition-colors hover:text-paper/80">
      {tr.cookies.manage}
    </button>
    <a
      href="https://revenueguru.com"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1.5 transition-colors hover:text-paper/80"
    >
      <RevenueGuruMark class="h-3.5 w-auto" />
      <span>{tr.designedBy} Revenue Guru</span>
    </a>
  </div>
</footer>
