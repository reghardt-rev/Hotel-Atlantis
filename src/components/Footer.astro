---
import SocialIcon from './SocialIcon.astro';
import Logo from './Logo.astro';
import RevenueGuruMark from './RevenueGuruMark.astro';
import { socialLinks } from '../lib/social';
import { partners, collectionHref } from '../lib/partners';
import { t, localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  settings: any;
}
const { locale, settings } = Astro.props;
const tr = t(locale);
const year = new Date().getFullYear();
const siteName = settings?.siteName ?? 'Hotel Atlantis';
const links = socialLinks(settings);
const sisterHotels = partners(locale);

// Every page the footer offers, in the order a visitor would work through them:
// what you book, what surrounds it, then the practical and the legal. Rooms,
// offers, activities and contact were previously homepage anchors; they are the
// same destinations as pages, which is what a footer should link to.
const footerLinks = [
  { href: localePath(locale, '/rooms'), label: tr.nav.rooms },
  { href: localePath(locale, '/offers'), label: tr.nav.offers },
  { href: localePath(locale, '/facilities'), label: tr.facilities.title },
  { href: localePath(locale, '/activities'), label: tr.nav.activities },
  { href: localePath(locale, '/amsterdam'), label: tr.nav.location },
  { href: localePath(locale, '/gallery'), label: tr.gallery.title },
  { href: localePath(locale, '/about'), label: tr.about },
  { href: localePath(locale, '/sustainability'), label: tr.sustainability },
  { href: localePath(locale, '/contact'), label: tr.nav.contact },
  { href: localePath(locale, '/faq'), label: 'FAQ' },
  { href: localePath(locale, '/terms'), label: tr.terms },
  { href: localePath(locale, '/privacy'), label: tr.privacy },
];
---

<footer class="bg-ink text-paper">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <Logo siteName={siteName} variant="light" class="h-20" />
      {settings?.tagline && <p class="mt-3 max-w-sm text-sm text-paper/70">{settings.tagline}</p>}

      {/* The other houses in the group. External, so they open away from the
          booking flow rather than navigating out of it. */}
      <div class="mt-8">
        <a
          href={collectionHref(locale)}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs uppercase tracking-[0.2em] text-paper/50 transition-colors hover:text-paper/80"
        >
          {tr.partners}
        </a>
        <ul class="mt-3 space-y-1 text-sm">
          {sisterHotels.map((hotel) => (
            <li>
              <a
                href={hotel.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-paper/80 transition-colors hover:text-paper"
              >
                {hotel.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Pages only. The homepage section anchors this column used to carry are
        the menu bar's job: from a page other than the homepage they navigate
        away and jump, which is not what a footer link should do. Each anchor
        that had a real page behind it keeps its place here as that page. */}
    <nav class="space-y-2 text-sm">
      {footerLinks.map((link) => (
        <a href={link.href} class="block text-paper/80 transition-colors hover:text-paper">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="space-y-1 text-sm text-paper/80">
      {settings?.address && <p class="whitespace-pre-line">{settings.address}</p>}
      {settings?.phone && (
        <p><a href={`tel:${settings.phone}`} class="hover:text-paper">{settings.phone}</a></p>
      )}
      {settings?.email && (
        <p><a href={`mailto:${settings.email}`} class="hover:text-paper">{settings.email}</a></p>
      )}
      {links.length > 0 && (
        <div class="flex flex-wrap gap-4 pt-3">
          {links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="text-paper/70 transition-colors hover:text-paper"
            >
              <SocialIcon name={link.key} />
            </a>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="flex flex-col items-center gap-2 border-t border-paper/10 py-5 text-center text-xs text-paper/50 sm:flex-row sm:justify-center sm:gap-4">
    <span>© {year} {siteName}</span>
    <button type="button" data-cookie-settings class="cursor-pointer underline transition-colors hover:text-paper/80">
      {tr.cookies.manage}
    </button>
    <a
      href="https://revenueguru.com"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1.5 transition-colors hover:text-paper/80"
    >
      <RevenueGuruMark class="h-3.5 w-auto" />
      <span>{tr.designedBy} Revenue Guru</span>
    </a>
  </div>
</footer>
