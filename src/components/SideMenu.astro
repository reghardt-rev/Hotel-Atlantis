---
/**
 * The full site index, as a panel that slides in from the right.
 *
 * Two tiers: the links that are also in the menu bar are set in bold, and
 * everything else on the site follows in normal weight. On a narrow screen the
 * bar has no links at all, so this panel is the whole navigation.
 *
 * It is a modal dialog: while it is open the page behind cannot be tabbed into
 * and cannot scroll. Closing returns focus to the button that opened it.
 */
import BookNow from './BookNow.astro';
import SocialIcon from './SocialIcon.astro';
import Logo from './Logo.astro';
import { t, localePath, sectionHref, sections, type Locale } from '../lib/i18n';
import { socialLinks } from '../lib/social';

interface Props {
  locale: Locale;
  siteName: string;
  mewsConfigId?: string;
  settings?: any;
}
const { locale, siteName, mewsConfigId, settings } = Astro.props;
const tr = t(locale);
const links = socialLinks(settings);

// Bold: everything that also appears in the menu bar, in the same order.
const primary = [
  ...sections.map((id) => ({ href: sectionHref(locale, id), label: tr.nav[id], section: id })),
  { href: localePath(locale, '/gallery'), label: tr.gallery.title },
  { href: localePath(locale, '/faq'), label: 'FAQ' },
];

// Normal weight: the rest of the site.
const secondary = [
  { href: localePath(locale, '/rooms'), label: tr.allRooms },
  { href: localePath(locale, '/activities'), label: tr.allActivities },
  { href: localePath(locale, '/facilities'), label: tr.facilities.title },
  { href: localePath(locale, '/amsterdam'), label: tr.nav.location },
  { href: localePath(locale, '/contact'), label: tr.nav.contact },
  { href: localePath(locale, '/about'), label: tr.about },
  { href: localePath(locale, '/sustainability'), label: tr.sustainability },
  { href: localePath(locale, '/socials'), label: tr.socials },
  { href: localePath(locale, '/privacy'), label: tr.privacy },
  { href: localePath(locale, '/terms'), label: tr.terms },
];
---

<div class="side-menu" data-side-menu>
  <div class="side-menu__backdrop" data-menu-backdrop></div>

  {/* The frosted pane, sitting still where the panel comes to rest. It is a
      separate layer because a blurred element cannot be slid in from off-screen:
      out there it has no page behind it to sample, so it paints as a flat light
      box and only turns frosted once it crosses the edge. This fades instead,
      and the panel above it carries the content in. */}
  <div class="side-menu__glass" aria-hidden="true"></div>

  <aside class="side-menu__panel" role="dialog" aria-modal="true" aria-label={tr.menu.open}>
    <div class="flex items-center justify-between border-b border-stone-warm px-6 py-4">
      <a href={localePath(locale, '/')} data-menu-link>
        {/* 44px: too small for the third line of the full lockup. */}
        <Logo siteName={siteName} variant="dark" lockup="compact" class="h-11" />
      </a>
      <button type="button" class="side-menu__close" data-menu-close aria-label={tr.menu.close}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-6 py-6">
      <ul class="space-y-1">
        {primary.map((item) => (
          <li>
            <a
              href={item.href}
              data-menu-link
              data-section-link={item.section ? '' : undefined}
              data-section={item.section}
              class="block rounded-lg px-3 py-2.5 font-semibold transition-colors hover:bg-sand"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <hr class="my-5 border-stone-warm" />

      <ul class="space-y-1">
        {secondary.map((item) => (
          <li>
            <a
              href={item.href}
              data-menu-link
              class="block rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-sand hover:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="border-t border-stone-warm px-6 py-5">
      <BookNow configId={mewsConfigId} label={tr.book} location="side_menu" class="w-full justify-center" />

      {links.length > 0 && (
        <>
          <p class="mt-5 text-center text-[0.65rem] uppercase tracking-[0.2em] text-muted">{tr.menu.follow}</p>
          <div class="mt-3 flex items-center justify-center gap-5">
            {links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.label}
                class="text-muted transition-colors hover:text-clay"
              >
                <SocialIcon name={link.key} />
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </aside>
</div>
