---
import Layout from '../layouts/Layout.astro';
import OfferCard from '../components/OfferCard.astro';
import { listOffers, getSettings } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const settings = await getSettings();
const offers = await listOffers(locale);
const mewsConfigId = settings?.mewsConfigId || undefined;
---

<Layout title={tr.nav.offers} locale={locale}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="text-xs uppercase tracking-[0.3em] text-clay">{tr.nav.offers}</p>
    <h1 class="mt-3 font-serif text-5xl">{tr.ourOffers}</h1>
    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {offers.map((offer) => <OfferCard offer={offer} locale={locale} mewsConfigId={mewsConfigId} />)}
    </div>
    {offers.length === 0 && <p class="mt-8 text-muted">No offers published yet.</p>}
  </section>
</Layout>
