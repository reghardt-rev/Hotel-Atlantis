---
import Layout from '../layouts/Layout.astro';
import { t, localePath, formatDate, type Locale } from '../lib/i18n';
import { getSettings } from '../lib/content';
import { articleSchema, hotelSchema, graph } from '../lib/schema';

interface Props {
  locale: Locale;
  activity: any;
  body: string;
}
const { locale, activity, body } = Astro.props;
const tr = t(locale);

const settings = await getSettings();
const schema = graph([
  hotelSchema(settings, locale, Astro.site),
  articleSchema(activity, locale, Astro.url.pathname, Astro.site),
]);
---

<Layout title={activity.title} description={activity.summary || ''} locale={locale} schema={schema}>
  <article class="mx-auto max-w-4xl px-4 py-16">
    <a href={localePath(locale, '/activities')} class="text-sm text-muted hover:text-ink">
      {tr.backToActivities}
    </a>

    <h1 class="mt-4 font-serif text-5xl sm:text-6xl">{activity.title}</h1>

    {activity.publishedAt && (
      <p class="mt-4 text-sm text-muted">{formatDate(locale, activity.publishedAt)}</p>
    )}

    <div class="mt-8 aspect-video w-full overflow-hidden rounded-xl bg-gradient-to-br from-sand via-stone-warm to-stone-warm">
      {activity.image && <img src={activity.image} alt={activity.imageAlt || activity.title} class="h-full w-full object-cover" />}
    </div>

    {/* Licence terms on borrowed photography require the credit to be visible,
        so it sits with the photo rather than in a page footer. */}
    {activity.image && activity.imageCredit && (
      <p class="mt-2 text-xs text-muted">{activity.imageCredit}</p>
    )}

    {activity.summary && (
      <p class="mt-8 font-serif text-2xl leading-snug text-ink">{activity.summary}</p>
    )}

    <div class="rich mt-8 text-ink" set:html={body} />

    <div class="mt-12 border-t border-stone-warm pt-8">
      <a href={localePath(locale, '/activities')} class="text-sm font-medium text-clay hover:underline">
        {tr.allActivities} →
      </a>
    </div>
  </article>
</Layout>
