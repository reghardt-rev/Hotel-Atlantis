---
/**
 * Every photograph on the site, on one page.
 *
 * The grid is CSS columns rather than a grid: the photography is a mix of
 * landscape room shots and upright details, and columns let each keep its own
 * proportions instead of being cropped to a common tile.
 *
 * Filtering is done by toggling a class on tiles that are already in the page,
 * not by re-rendering, so the site stays static and the lightbox indices below
 * never have to be rebuilt.
 */
import Layout from '../layouts/Layout.astro';
import { listAllPhotos } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const photos = await listAllPhotos(locale);

// Only offer a filter for groups that actually have photographs in them.
const groups = (['hotel', 'rooms', 'activities', 'offers'] as const).filter((g) =>
  photos.some((p) => p.group === g),
);
---

<Layout title={tr.gallery.title} description={tr.gallery.intro} locale={locale}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="text-xs uppercase tracking-[0.3em] text-clay">{tr.gallery.title}</p>
    <h1 class="mt-3 font-serif text-5xl">{tr.gallery.intro}</h1>

    {photos.length === 0 ? (
      <p class="mt-8 text-muted">{tr.gallery.empty}</p>
    ) : (
      <>
        {groups.length > 1 && (
          <div class="mt-10 flex flex-wrap gap-2" data-gallery-filters>
            <button type="button" data-filter="all" class="gal-chip" aria-pressed="true">
              {tr.gallery.all}
            </button>
            {groups.map((g) => (
              <button type="button" data-filter={g} class="gal-chip" aria-pressed="false">
                {tr.gallery[g]}
              </button>
            ))}
          </div>
        )}

        <div class="mt-10 gap-4 [column-count:1] sm:[column-count:2] lg:[column-count:3]" data-gallery-grid>
          {photos.map((photo, i) => (
            <button
              type="button"
              data-tile
              data-group={photo.group}
              data-credit={photo.credit ?? ''}
              class="mb-4 block w-full break-inside-avoid overflow-hidden rounded-xl bg-stone-warm text-left"
            >
              <img
                src={photo.src}
                alt={photo.alt}
                loading={i < 6 ? 'eager' : 'lazy'}
                decoding="async"
                class="w-full transition-transform duration-500 hover:scale-[1.03]"
              />
            </button>
          ))}
        </div>
      </>
    )}
  </section>

  {/* Lightbox. Hidden until a tile is clicked; it reads each photo straight off
      the tile that opened it, so nothing about the set is duplicated into a
      second copy that could drift out of step with the grid. */}
  {photos.length > 0 && (
    <div
      data-lightbox
      hidden
      role="dialog"
      aria-modal="true"
      aria-label={tr.gallery.title}
      class="fixed inset-0 z-[60] flex flex-col bg-ink/95 backdrop-blur-sm"
    >
      <div class="flex items-center justify-between px-4 py-3 text-white/80">
        <p data-lb-count class="text-xs tracking-[0.2em]"></p>
        <button type="button" data-lb-close aria-label={tr.gallery.close} class="gal-nav text-2xl">×</button>
      </div>

      <div class="relative flex flex-1 items-center justify-center px-4 pb-4">
        <button type="button" data-lb-prev aria-label={tr.gallery.prev} class="gal-nav absolute left-3 text-3xl">‹</button>
        <img data-lb-img src="" alt="" class="max-h-full max-w-full rounded-lg object-contain" />
        <button type="button" data-lb-next aria-label={tr.gallery.next} class="gal-nav absolute right-3 text-3xl">›</button>
      </div>

      <div class="px-4 pb-5 text-center">
        <p data-lb-alt class="text-sm text-white"></p>
        <p data-lb-credit class="mt-1 text-xs text-white/60"></p>
      </div>
    </div>
  )}

</Layout>

<script>
  const grid = document.querySelector<HTMLElement>('[data-gallery-grid]');
  const box = document.querySelector<HTMLElement>('[data-lightbox]');

  if (grid && box) {
    const img = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const altText = box.querySelector<HTMLElement>('[data-lb-alt]')!;
    const creditText = box.querySelector<HTMLElement>('[data-lb-credit]')!;
    const countText = box.querySelector<HTMLElement>('[data-lb-count]')!;
    const closeBtn = box.querySelector<HTMLButtonElement>('[data-lb-close]')!;
    const tiles = Array.from(grid.querySelectorAll<HTMLElement>('[data-tile]'));

    // The lightbox steps through what is currently on screen, not the whole
    // set: after filtering to Rooms, "next" should not wander into activities.
    let visible = tiles.filter((t) => !t.hidden);
    let at = 0;
    // The tile that opened the lightbox, so focus can go back where it was.
    let opener: HTMLElement | null = null;

    function show(pos: number) {
      if (!visible.length) return;
      at = (pos + visible.length) % visible.length;
      const tile = visible[at];
      const source = tile.querySelector('img');
      if (!source) return;
      img.src = source.src;
      img.alt = source.alt;
      altText.textContent = source.alt;
      creditText.textContent = tile.dataset.credit || '';
      countText.textContent = `${at + 1} / ${visible.length}`;
    }

    function open(tile: HTMLElement) {
      const pos = visible.indexOf(tile);
      if (pos === -1) return;
      show(pos);
      opener = tile;
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      // aria-modal only claims the rest of the page is inert; moving focus is
      // what actually makes it so for a keyboard.
      closeBtn.focus();
    }

    function close() {
      box.hidden = true;
      document.body.style.overflow = '';
      opener?.focus();
      opener = null;
    }

    grid.addEventListener('click', (e) => {
      const tile = (e.target as HTMLElement).closest<HTMLElement>('[data-tile]');
      if (tile) open(tile);
    });

    box.querySelector('[data-lb-close]')?.addEventListener('click', close);
    box.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(at - 1));
    box.querySelector('[data-lb-next]')?.addEventListener('click', () => show(at + 1));

    // Clicking the backdrop closes; clicking the photo or a control must not.
    // Testing `e.target === box` would never fire: the three rows inside cover
    // the overlay completely, so the click always lands on one of them.
    box.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('img, button')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(at - 1);
      else if (e.key === 'ArrowRight') show(at + 1);
      else if (e.key === 'Tab') {
        // Keep Tab inside the dialog rather than letting it walk the grid behind.
        const stops = Array.from(box.querySelectorAll<HTMLElement>('button'));
        const edge = e.shiftKey ? stops[0] : stops[stops.length - 1];
        if (document.activeElement === edge) {
          e.preventDefault();
          (e.shiftKey ? stops[stops.length - 1] : stops[0]).focus();
        }
      }
    });

    const filters = document.querySelector<HTMLElement>('[data-gallery-filters]');
    filters?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const want = btn.dataset.filter!;

      filters.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b === btn)),
      );
      tiles.forEach((tile) => {
        tile.hidden = want !== 'all' && tile.dataset.group !== want;
      });
      visible = tiles.filter((t) => !t.hidden);
    });
  }
</script>
