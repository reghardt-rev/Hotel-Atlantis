---
import Layout from '../layouts/Layout.astro';
import { faqCategories, faqPageTitle } from '../lib/faq';
import type { Locale } from '../lib/i18n';
import { getSettings } from '../lib/content';
import { faqSchema, hotelSchema, graph } from '../lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const settings = await getSettings();
const schema = graph([
  hotelSchema(settings, locale, Astro.site),
  faqSchema(locale, Astro.url.pathname, Astro.site),
]);
---

<Layout title={faqPageTitle[locale]} locale={locale} schema={schema}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-xs uppercase tracking-[0.3em] text-clay">FAQ</p>
    <h1 class="mt-3 font-serif text-5xl">{faqPageTitle[locale]}</h1>

    {faqCategories.map((cat) => (
      <div class="mt-14">
        <h2 class="font-serif text-2xl text-clay">{cat.title[locale]}</h2>
        <div class="mt-4 divide-y divide-stone-warm border-y border-stone-warm">
          {cat.items.map((item) => (
            <details class="group">
              <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 text-lg font-medium marker:content-['']">
                {item.q[locale]}
                <span class="text-clay transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="pb-5 leading-relaxed text-muted">{item.a[locale]}</p>
            </details>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
