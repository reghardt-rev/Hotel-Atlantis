---
/**
 * One facility. Built like the activity detail page so the two read as the same
 * kind of thing, minus the date: a facility is not news and dating it only
 * makes it look stale.
 */
import Layout from '../layouts/Layout.astro';
import { t, localePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  facility: any;
  body: string;
}
const { locale, facility, body } = Astro.props;
const tr = t(locale);
---

<Layout title={facility.title} description={facility.summary || ''} locale={locale}>
  <article class="mx-auto max-w-4xl px-4 py-16">
    <a href={localePath(locale, '/facilities')} class="text-sm text-muted hover:text-ink">
      {tr.facilities.back}
    </a>

    <h1 class="mt-4 font-serif text-5xl sm:text-6xl">{facility.title}</h1>

    <div class="mt-8 aspect-video w-full overflow-hidden rounded-xl bg-gradient-to-br from-sand via-stone-warm to-stone-warm">
      {facility.image && (
        <img
          src={facility.image}
          alt={facility.imageAlt || facility.title}
          class="h-full w-full object-cover"
        />
      )}
    </div>

    {facility.highlights?.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-x-3 gap-y-2 text-sm text-clay">
        {facility.highlights.map((h: string) => (
          <li class="rounded-full border border-stone-warm px-4 py-1.5">{h}</li>
        ))}
      </ul>
    )}

    {facility.summary && (
      <p class="mt-8 font-serif text-2xl leading-snug text-ink">{facility.summary}</p>
    )}

    <div class="rich mt-8 text-ink" set:html={body} />

    <div class="mt-12 border-t border-stone-warm pt-8">
      <a href={localePath(locale, '/facilities')} class="text-sm font-medium text-clay hover:underline">
        {tr.facilities.all} →
      </a>
    </div>
  </article>
</Layout>
