---
import Layout from '../layouts/Layout.astro';
import RoomCard from '../components/RoomCard.astro';
import { listRooms } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const rooms = await listRooms(locale);
---

<Layout title={tr.nav.rooms} locale={locale}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="text-xs uppercase tracking-[0.3em] text-clay">{tr.nav.rooms}</p>
    <h1 class="mt-3 font-serif text-5xl">{tr.ourRooms}</h1>
    <div class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {rooms.map((room) => <RoomCard room={room} locale={locale} />)}
    </div>
    {rooms.length === 0 && <p class="mt-8 text-muted">No rooms published yet.</p>}
  </section>
</Layout>
