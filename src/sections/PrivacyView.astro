---
/**
 * Privacy policy. The body lives in the shared `pages` collection under the
 * slug `privacy`, so staff (or a lawyer) can edit it in Keystatic without a
 * code change.
 */
import Layout from '../layouts/Layout.astro';
import { getPage, renderMarkdoc } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);

const page = await getPage(locale, 'privacy');
const body = page ? await renderMarkdoc(page.content) : '';
const title = page?.title || tr.privacy;
---

<Layout title={title} description={page?.seoDescription || ''} locale={locale}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-serif text-5xl">{title}</h1>
    {body ? (
      <div class="rich mt-8 text-ink" set:html={body} />
    ) : (
      <p class="mt-8 text-muted">—</p>
    )}
  </article>
</Layout>
