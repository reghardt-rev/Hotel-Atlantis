---
import Layout from '../layouts/Layout.astro';
import BookNow from '../components/BookNow.astro';
import BookingBar from '../components/BookingBar.astro';
import CityScenery from '../components/CityScenery.astro';
import Carousel from '../components/Carousel.astro';
import ReviewScore from '../components/ReviewScore.astro';
import ReviewSlideshow from '../components/ReviewSlideshow.astro';
import DirectBookingBox from '../components/DirectBookingBox.astro';
import RoomRail from '../components/RoomRail.astro';
import OfferCard from '../components/OfferCard.astro';
import Benefits from '../components/sections/Benefits.astro';
import Welcome from '../components/sections/Welcome.astro';
import ActivitiesSection from '../components/sections/ActivitiesSection.astro';
import LocationSection from '../components/sections/LocationSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import { listRooms, listOffers, getSettings, getHomepage, getDirectBooking, getReviews } from '../lib/content';
import { t, localePath, type Locale } from '../lib/i18n';
import { hotelSchema, graph } from '../lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);

const settings = await getSettings();
const homepage = await getHomepage();
const directBooking = await getDirectBooking(locale);
// One list, translated per review: see the note on getReviews. Empty until the
// first quote is entered in Keystatic, which puts the aggregate score box back
// on the hero rather than leaving the corner bare.
const reviews = await getReviews(locale);
// The whole set: the rail loops, so there is no last card to run out of.
const rooms = await listRooms(locale);
const offers = await listOffers(locale);
const mewsConfigId = settings?.mewsConfigId || undefined;
const siteName = settings?.siteName || 'Hotel Atlantis';
// No static fallback. Clearing the tagline in Keystatic has to actually clear
// it, rather than falling back to a line nobody can edit.
const tagline = String(settings?.tagline ?? '').trim();
// The checkbox only governs the hero. The text itself, when there is any, still
// describes the page to search engines and still appears in the footer.
const showTagline = settings?.showTagline !== false && tagline !== '';

const schema = graph([hotelSchema(settings, locale, Astro.site)]);

// Keystatic stores a bare filename for anything uploaded through it and a full
// path for anything set by hand, so both shapes have to resolve.
const toSlides = (list: any[], folder: string) =>
  (list ?? [])
    .map((s: any) => {
      const img = typeof s.image === 'string' ? s.image : '';
      const src = img.startsWith('/') || img.startsWith('http') ? img : `/images/${folder}/${img}`;
      return { image: src, alt: s.alt || siteName, focal: s.focal || undefined };
    })
    .filter((s: any) => s.image);

const slidesA = toSlides(homepage?.carousel, 'carousel');
const slidesBAll = toSlides((homepage as any)?.carouselB, 'carousel-b');

// `heroVariant` in Homepage settings. Forcing a side ends the test rather than
// rigging it: the chosen set is passed as the only set, so the page ships one
// arm, assigns nobody and reports no experiment. Forcing B with no B slides
// falls back to A rather than leaving the hero empty.
const heroChoice = (homepage as any)?.heroVariant ?? 'test';
const testing = heroChoice === 'test' && slidesBAll.length > 0;
const slides = heroChoice === 'b' && slidesBAll.length > 0 ? slidesBAll : slidesA;
const slidesB = testing ? slidesBAll : [];
---

<Layout title={siteName} description={tagline} locale={locale} heroHeader={true} schema={schema}>
  {/* Sections arrive as they are scrolled to. Inline and first, so the root is
      flagged before anything below is parsed and nothing is ever painted in
      place and then hidden. See the note on `.reveal` in global.css. */}
  <script is:inline>
    (function () {
      var root = document.documentElement;
      // No observer, no reveal: the flag is never set, none of the CSS matches
      // and the page renders exactly as it would have without any of this.
      if (!('IntersectionObserver' in window)) return;
      root.setAttribute('data-reveal', '');

      function start() {
        var waiting = [].slice.call(document.querySelectorAll('.reveal, [data-reveal-group]'));

        function reveal(el) {
          var i = waiting.indexOf(el);
          if (i === -1) return;
          waiting.splice(i, 1);
          // A group's children come in one behind another. Capped, or the last
          // card of a long grid is still waiting well after the row it belongs
          // to has finished arriving.
          if (el.hasAttribute('data-reveal-group')) {
            for (var c = 0; c < el.children.length; c++) {
              el.children[c].style.transitionDelay = Math.min(c * 70, 420) + 'ms';
            }
          }
          el.classList.add('is-in');
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              reveal(entry.target);
              // Arriving is a one-off, not a scroll effect: scrolling back up
              // and down again must not play the whole page a second time.
              observer.unobserve(entry.target);
            });
          },
          // The trigger line sits a quarter of the way up the window, so a
          // section has to be properly on screen and read as arrived-at rather
          // than appearing the instant its top edge clears the bottom of the
          // glass. Raise the percentage to make things wait longer still.
          { rootMargin: '0px 0px -25% 0px', threshold: 0 },
        );

        waiting.slice().forEach(function (el) {
          observer.observe(el);
        });

        // Holding the trigger a quarter of the way up costs the bottom of the
        // page: anything sitting inside that last quarter at full scroll can
        // never cross the line, and would stay invisible however far the reader
        // goes. At the end of the document, everything still waiting has by
        // definition been reached.
        function sweep() {
          if (!waiting.length) {
            window.removeEventListener('scroll', sweep);
            return;
          }
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
            waiting.slice().forEach(function (el) {
              observer.unobserve(el);
              reveal(el);
            });
          }
        }
        window.addEventListener('scroll', sweep, { passive: true });
        sweep();
      }

      try {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start);
        } else {
          start();
        }
      } catch (e) {
        // Nothing is going to reveal these, so hand the page back unhidden.
        root.removeAttribute('data-reveal');
      }
    })();
  </script>

  {/* Hero */}
  {slides.length > 0 ? (
    <Carousel slides={slides} slidesB={slidesB}>
      {/* No name over the photograph: the wordmark in the header says it, and
          saying it twice on one screen reads as a mistake. The heading still has
          to exist, so with the tagline switched off the name stays as a heading
          for screen readers and search engines without being drawn. */}
      {!showTagline && <h1 class="sr-only">{siteName}</h1>}

      {/* The tagline reads as an introduction to the booking bar rather than as a
          caption on the photograph, so it sits with it. Smaller on a narrow
          screen, where the bar stacks and takes most of the height. */}
      {showTagline && (
        <h1
          slot="bottom-lead"
          class="hero-type font-serif text-3xl leading-[1.05] sm:text-5xl lg:text-6xl"
        >
          {tagline}
        </h1>
      )}
      {/* Both overlays go into the slot through one Fragment rather than as two
          children carrying `slot="top-right"` each. A `slot` attribute written
          inside an expression hands Astro the whole expression as that slot's
          content, which silently drops any sibling claiming the same name: the
          direct-booking box disappeared off the hero when the rating below was
          first made conditional. The Fragment renders no element, so the two
          panels are still the flex children of the overlay column, rating first.
          If either of these ever becomes conditional again, keep the condition
          inside here. */}
      <Fragment slot="top-right">
        {/* The reviews are a desktop overlay. On a phone the hero is one column
            of photograph with the booking bar across the foot of it, and two
            stacked panels in the corner leave the guest reading a quote instead
            of seeing where they are staying. The booking box earns its place
            there; a rotating rating does not, so it is hidden below `md` and the
            corner is left to the one panel that asks for something.

            Hidden in CSS rather than dropped from the markup, so the quotes are
            still in the page for search engines, and so the fitting script in
            Carousel can measure a column that really is just the box. */}
        {reviews.length > 0 ? (
          <ReviewSlideshow
            class="hidden md:block"
            locale={locale}
            reviews={reviews}
            source={settings?.reviewSource}
          />
        ) : (
          <ReviewScore
            class="hidden md:block"
            locale={locale}
            score={settings?.reviewScore}
            reviews={settings?.reviewCount}
            source={settings?.reviewSource}
          />
        )}
        <DirectBookingBox
          locale={locale}
          title={directBooking.title}
          items={directBooking.items}
          configId={mewsConfigId}
        />
      </Fragment>
      <BookingBar slot="bottom" locale={locale} />
    </Carousel>
  ) : (
    <section class="flex min-h-[70vh] items-center justify-center bg-gradient-to-b from-sand to-paper px-4 text-center">
      <div>
        {showTagline ? (
          <>
            <p class="text-xs uppercase tracking-[0.35em] text-clay">{siteName}</p>
            <h1 class="mt-5 font-serif text-5xl leading-tight sm:text-7xl">{tagline}</h1>
          </>
        ) : (
          <h1 class="font-serif text-5xl leading-tight sm:text-7xl">{siteName}</h1>
        )}
        <div class="mt-9"><BookNow configId={mewsConfigId} label={tr.book} location="hero" class="!px-8 !py-3.5" /></div>
      </div>
    </section>
  )}

  <Benefits locale={locale} />

  <Welcome locale={locale} />

  {/* Rooms */}
  {rooms.length > 0 && <RoomRail rooms={rooms} locale={locale} />}

  {/* Offers */}
  {offers.length > 0 && (
    <section id="offers" class="reveal-frame bg-sand">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
        {/* Heading and the way through to the full list on one line, as the
            activities section does it. */}
        <div class="reveal flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-clay">{tr.nav.offers}</p>
            <h2 class="mt-3 font-serif text-4xl sm:text-5xl">{tr.ourOffers}</h2>
          </div>
          <a href={localePath(locale, '/offers')} class="text-sm font-medium text-clay hover:underline">
            {tr.allOffers} →
          </a>
        </div>
        <div class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group="right">
          {offers.map((offer) => <OfferCard offer={offer} locale={locale} mewsConfigId={mewsConfigId} />)}
        </div>
      </div>
    </section>
  )}

  <ActivitiesSection locale={locale} />

  <LocationSection locale={locale} />

  <FaqSection locale={locale} />

  <ContactSection locale={locale} settings={settings} />

  <CityScenery />
</Layout>
