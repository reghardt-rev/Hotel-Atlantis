# Copy to `.env` and fill in. `.env` is gitignored.

# ---- Analytics (optional) ----
# Google Tag Manager container id, e.g. GTM-XXXXXXX.
# You manage GA4 inside GTM yourself. You can set this here OR, more conveniently,
# in Keystatic -> Site settings (the settings value wins over this env var).
PUBLIC_GTM_ID=

# ---- Keystatic GitHub mode (production /keystatic admin only) ----
# NOT needed for local dev: `npm run dev` uses local storage automatically.
# These are generated when you open the deployed /keystatic and click through
# "Connect to GitHub", which creates a GitHub App for reghardt-rev/Paradis-ZAN.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
